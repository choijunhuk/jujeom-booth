# Copy to .env on the server (never commit .env). STAFF_PIN must be >= 6 chars (server refuses to start otherwise);
# login lockout is global (flat 60 s after 5 failures), not per IP.
STAFF_PIN=change-me-123456
PORT=8787
HOST=0.0.0.0
BASE_PATH=/booth
DATA_DIR=/data
PUBLIC_ORIGIN=https://coms.kw.ac.kr
COOKIE_SECURE=1
# PAY_* only seed the payment settings on the very first boot; afterwards staff edit them in the app
PAY_BANK=
PAY_ACCOUNT=
PAY_HOLDER=
# Staff session length in hours (default 72, covers a multi-day event)
SESSION_HOURS=72
# COMS member discount: club backend endpoint that validates the visitor's club login cookie (`token`). Unset = feature off.
COMS_ME_URL=https://coms.kw.ac.kr/api/auth/me
# Numeric settings must be plain integers (the server refuses to start otherwise).
# Default for the staff setting "per-member limit" of a FRESH database only (default 20, >= 1); later changes are made by staff
MEMBER_ORDER_MAX=20
# Total size cap for menu photos stored in DATA_DIR/photos, in bytes (default 41943040 = 40 MB)
PHOTO_STORAGE_MAX=41943040
# tables.json ("count") only seeds the table count on the first boot; later changes are made by staff (1..50)
